dat:DateInterval a sh:NodeShape ;
	rdfs:comment "A span between two dates. The end is excluded and may be absent. DAT-023." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n2 ;
	sh:property _:c14n106 , _:c14n61 ;
	sh:targetClass dat:DateInterval .
party:ContactMechanism a sh:NodeShape ;
	rdfs:comment "A way to reach a party: a postal address, a telephone number, a telephone short code or an email address. Apache OFBiz calls it ContactMech. DMO-045." ;
	sh:closed false ;
	sh:ignoredProperties _:c14n34 ;
	sh:property _:c14n129 , _:c14n140 , _:c14n153 , _:c14n22 , _:c14n36 ;
	sh:targetClass party:ContactMechanism .
party:EmailAddress a sh:NodeShape ;
	rdfs:comment "An email address. DMO-034." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n91 ;
	sh:property _:c14n0 , _:c14n120 , _:c14n155 , _:c14n159 , _:c14n168 , _:c14n75 ;
	sh:targetClass party:EmailAddress .
party:Entity a sh:NodeShape ;
	rdfs:comment "Fields that every entity of the model has: an identifier, audit instants and the extensions object. An entity is a class whose records exist on their own and that other data can refer to. A value class, such as PersonName or DateInterval, exists only inlined in an entity, so it has no identifier and no audit instants. Departs from Apache OFBiz (DMO-006): each entity has its own UUID key, never a key of several fields. DMO-021, DMO-022, DMO-050, DMO-053." ;
	sh:closed false ;
	sh:ignoredProperties _:c14n57 ;
	sh:property _:c14n110 , _:c14n37 , _:c14n51 , _:c14n8 ;
	sh:targetClass party:Entity .
party:Extensions a sh:NodeShape ;
	rdfs:comment "The extensions object. Each member is named after the ISO 3166-1 or ISO 3166-2 code of one jurisdiction, in lowerCamelCase, such as ca or caQc. A jurisdiction with no such code nests its member in the member of the nearest coded jurisdiction, such as caQc.montreal. Its value is an object that the profile of that jurisdiction defines. The core model accepts any member, so that a system can keep extensions it does not know. The generated SHACL shape of this class is left open after generation, as model/test-model.sh records. DMO-053, DMO-056." ;
	sh:targetClass party:Extensions .
party:Organization a sh:NodeShape ;
	rdfs:comment "A group of people with a shared purpose, such as a business, a public body or an association. Apache OFBiz calls it PartyGroup. DMO-042." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n154 ;
	sh:property _:c14n167 , _:c14n170 , _:c14n19 , _:c14n33 , _:c14n5 , _:c14n67 ;
	sh:targetClass party:Organization .
party:OrganizationName a sh:NodeShape ;
	rdfs:comment "One name of an organization, as registered or used. A value class inlined in its organization, so it has no identifier and no audit instants. DMO-021, DMO-035, DMO-042." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n115 ;
	sh:property _:c14n130 , _:c14n152 , _:c14n40 , _:c14n65 ;
	sh:targetClass party:OrganizationName .
party:Party a sh:NodeShape ;
	rdfs:comment "A person or an organization. Each party is exactly one of the two. DMO-040." ;
	sh:closed false ;
	sh:ignoredProperties _:c14n93 ;
	sh:property _:c14n108 , _:c14n117 , _:c14n156 , _:c14n32 , _:c14n87 ;
	sh:targetClass party:Party .
party:PartyClassification a sh:NodeShape ;
	rdfs:comment "Places a party in a category of a controlled vocabulary, such as an industry. Departs from Apache OFBiz (DMO-006): OFBiz links a party to a PartyClassificationGroup record. This model holds the URI of a concept scheme and a code, so that categories come from published vocabularies (DMO-030). DMO-047." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n118 ;
	sh:property _:c14n133 , _:c14n142 , _:c14n26 , _:c14n35 , _:c14n43 , _:c14n46 , _:c14n56 , _:c14n73 ;
	sh:targetClass party:PartyClassification .
party:PartyContactMechanism a sh:NodeShape ;
	rdfs:comment "Links a party to a contact mechanism, for some purposes and a period. DMO-045." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n21 ;
	sh:property _:c14n102 , _:c14n136 , _:c14n144 , _:c14n172 , _:c14n52 , _:c14n58 , _:c14n86 , _:c14n98 ;
	sh:targetClass party:PartyContactMechanism .
party:PartyContainer a sh:NodeShape ;
	rdfs:comment "A container that carries records of the Party subject area in one document, one list per class, such as for a bulk exchange or a test. It is not an entity: it has no identifier and no audit instants. It is the root class of the generated JSON Schema. DMO-014." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n1 ;
	sh:property _:c14n121 , _:c14n132 , _:c14n141 , _:c14n38 , _:c14n60 , _:c14n64 , _:c14n78 , _:c14n79 , _:c14n80 , _:c14n83 , _:c14n97 ;
	sh:targetClass party:PartyContainer .
party:PartyIdentification a sh:NodeShape ;
	rdfs:comment "An identifier that a body issued for a party, such as a business number. Departs from Apache OFBiz (DMO-006): OFBiz keys PartyIdentification by the party and the identification type, with no period and no issuer, so a party holds one identifier per type. This model gives each identification its own id, a period and an optional issuer, because an identifier can expire or be replaced while the party stays the same. DMO-046." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n137 ;
	sh:property _:c14n116 , _:c14n147 , _:c14n157 , _:c14n25 , _:c14n29 , _:c14n76 , _:c14n82 , _:c14n89 , _:c14n92 ;
	sh:targetClass party:PartyIdentification .
party:PartyRelationship a sh:NodeShape ;
	rdfs:comment "A relationship between two parties, each in a role, such as an employee and an employer. DMO-044." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n103 ;
	sh:property _:c14n10 , _:c14n112 , _:c14n122 , _:c14n135 , _:c14n151 , _:c14n163 , _:c14n169 , _:c14n23 , _:c14n4 , _:c14n41 ;
	sh:targetClass party:PartyRelationship .
party:PartyRole a sh:NodeShape ;
	rdfs:comment "A role that a party plays, such as applicant, employer or supplier. Departs from Apache OFBiz (DMO-006): the role has a period, and the role is a code instead of a RoleType record. DMO-043." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n31 ;
	sh:property _:c14n109 , _:c14n124 , _:c14n128 , _:c14n14 , _:c14n143 , _:c14n44 , _:c14n71 ;
	sh:targetClass party:PartyRole .
party:Person a sh:NodeShape ;
	rdfs:comment "A human being. DMO-041." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n50 ;
	sh:property _:c14n123 , _:c14n53 , _:c14n55 , _:c14n62 , _:c14n69 , _:c14n94 , _:c14n99 ;
	sh:targetClass party:Person .
party:PersonName a sh:NodeShape ;
	rdfs:comment "One name of a person, a value class inlined in its person, so it has no identifier and no audit instants. Only the full name is required. Departs from Apache OFBiz (DMO-006): OFBiz keeps one set of name parts on Person, such as firstName and lastName, and a PartyNameHistory keyed by the date of change. This model keeps several names, each with a type and a period, and requires only the full name, because many names have no first and last parts (LOC-050). DMO-021, DMO-032." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n171 ;
	sh:property _:c14n12 , _:c14n148 , _:c14n149 , _:c14n15 , _:c14n158 , _:c14n45 ;
	sh:targetClass party:PersonName .
party:PostalAddress a sh:NodeShape ;
	rdfs:comment "A postal address in separate fields, kept as written. Only the country is required. Departs from Apache OFBiz (DMO-006): OFBiz holds address1 and address2, a numeric houseNumber, recipient names, and references to Geo records for the city, the region and the country. This model keeps each part as written, with the region and the country as codes in the form of their issuer, and holds no recipient name, because each country orders and writes its addresses in its own way (LOC-053, DAT-066). DMO-033, LOC-055." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n66 ;
	sh:property _:c14n100 , _:c14n113 , _:c14n126 , _:c14n134 , _:c14n160 , _:c14n24 , _:c14n54 , _:c14n7 , _:c14n72 , _:c14n74 , _:c14n81 , _:c14n85 , _:c14n9 , _:c14n90 ;
	sh:targetClass party:PostalAddress .
party:TelephoneNumber a sh:NodeShape ;
	rdfs:comment "A telephone number in the international form. Departs from Apache OFBiz (DMO-006): OFBiz TelecomNumber splits the country code, the area code and the number, and keeps the extension on PartyContactMech. This model keeps one E.164 string, because not every numbering plan has area codes, and keeps the extension with the number. DMO-034." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n18 ;
	sh:property _:c14n104 , _:c14n11 , _:c14n13 , _:c14n166 , _:c14n20 , _:c14n30 , _:c14n6 ;
	sh:targetClass party:TelephoneNumber .
party:TelephoneShortCode a sh:NodeShape ;
	rdfs:comment "A short code that people dial within one country, such as 211 or 311. It has no E.164 form, so it is a separate kind of contact mechanism. DMO-034." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n138 ;
	sh:property _:c14n150 , _:c14n165 , _:c14n3 , _:c14n39 , _:c14n48 , _:c14n63 , _:c14n84 ;
	sh:targetClass party:TelephoneShortCode .
