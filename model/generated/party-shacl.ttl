dat:InstantInterval a sh:NodeShape ;
	rdfs:comment "A span between two instants. The end is excluded and may be absent. DAT-023." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n87 ;
	sh:property _:c14n121 , _:c14n81 ;
	sh:targetClass dat:InstantInterval .
dat:Money a sh:NodeShape ;
	rdfs:comment "An amount of money. DAT-050 to DAT-053." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n8 ;
	sh:property _:c14n43 , _:c14n89 ;
	sh:targetClass dat:Money .
dat:MultilingualText a sh:NodeShape ;
	rdfs:comment "Text in English and French, keyed by language tag. Other language tags are allowed as extra members. DAT-004 to DAT-006." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n30 ;
	sh:property _:c14n51 , _:c14n73 ;
	sh:targetClass dat:MultilingualText .
dat:Point a sh:NodeShape ;
	rdfs:comment "A GeoJSON point: longitude, then latitude, in WGS 84 decimal degrees. DAT-080, DAT-081." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n114 ;
	sh:property _:c14n175 , _:c14n9 ;
	sh:targetClass dat:Point .
dat:ZonedLocalDateTime a sh:NodeShape ;
	rdfs:comment "A wall-clock date and time with the time zone it belongs to. DAT-015." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n11 ;
	sh:property _:c14n157 , _:c14n7 ;
	sh:targetClass dat:ZonedLocalDateTime .
party:ContactMechanism a sh:NodeShape ;
	rdfs:comment "A way to reach a party: a postal address, a telephone number or an email address. Apache OFBiz calls it ContactMech. DMO-045." ;
	sh:closed false ;
	sh:ignoredProperties _:c14n38 ;
	sh:property _:c14n107 , _:c14n126 , _:c14n154 , _:c14n21 , _:c14n84 ;
	sh:targetClass party:ContactMechanism .
party:EmailAddress a sh:NodeShape ;
	rdfs:comment "An email address. DMO-034." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n91 ;
	sh:property _:c14n104 , _:c14n122 , _:c14n128 , _:c14n145 , _:c14n167 , _:c14n48 ;
	sh:targetClass party:EmailAddress .
party:Entity a sh:NodeShape ;
	rdfs:comment "Fields that every entity of the model has: an identifier, audit instants and the extensions object. Departs from Apache OFBiz (DMO-006): each entity has its own UUID key, never a key of several fields. DMO-021, DMO-022, DMO-050, DMO-053." ;
	sh:closed false ;
	sh:ignoredProperties _:c14n62 ;
	sh:property _:c14n109 , _:c14n111 , _:c14n115 , _:c14n95 ;
	sh:targetClass party:Entity .
party:Extensions a sh:NodeShape ;
	rdfs:comment "The extensions object. Each member is named after the ISO 3166-1 or ISO 3166-2 code of one jurisdiction, in lowerCamelCase, such as ca or caQc. Its value is an object that the profile of that jurisdiction defines. The core model accepts any member, so that a system can keep extensions it does not know. DMO-053, DMO-056." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n177 ;
	sh:targetClass party:Extensions .
party:Organization a sh:NodeShape ;
	rdfs:comment "A group of people with a shared purpose, such as a business, a public body or an association. Apache OFBiz calls it PartyGroup. DMO-042." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n155 ;
	sh:property _:c14n138 , _:c14n170 , _:c14n173 , _:c14n24 , _:c14n96 , _:c14n97 ;
	sh:targetClass party:Organization .
party:OrganizationName a sh:NodeShape ;
	rdfs:comment "One name of an organization, as registered or used. DMO-035, DMO-042." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n118 ;
	sh:property _:c14n130 , _:c14n153 , _:c14n41 , _:c14n69 ;
	sh:targetClass party:OrganizationName .
party:Party a sh:NodeShape ;
	rdfs:comment "A person or an organization. Each party is exactly one of the two. DMO-040." ;
	sh:closed false ;
	sh:ignoredProperties _:c14n93 ;
	sh:property _:c14n119 , _:c14n164 , _:c14n35 , _:c14n50 , _:c14n90 ;
	sh:targetClass party:Party .
party:PartyClassification a sh:NodeShape ;
	rdfs:comment "Places a party in a category of a controlled vocabulary, such as an industry. DMO-047." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n120 ;
