	sh:targetClass party:PartyIdentification .
party:PartyRelationship a sh:NodeShape ;
	rdfs:comment "A relationship between two parties, each in a role, such as an employee and an employer. DMO-044." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n106 ;
