@prefix contactMechanismTypes: <https://fpsot.org/vocabularies/contact-mechanism-types/concepts/> .
@prefix partyTypes: <https://fpsot.org/vocabularies/party-types/concepts/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dat: <https://fpsot.org/model/data-types/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix party: <https://fpsot.org/model/party/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
dat:CalendarDate a rdfs:Datatype ;
	owl:equivalentClass _:c14n85 .
dat:CodeValue a rdfs:Datatype ;
	owl:equivalentClass _:c14n108 .
dat:DateInterval a owl:Class ;
	rdfs:label "DateInterval" ;
	rdfs:subClassOf _:c14n127 , _:c14n17 , _:c14n198 , _:c14n213 , _:c14n228 , _:c14n30 ;
	skos:definition "A span between two dates. The end is excluded and may be absent. DAT-023." ;
	skos:inScheme <https://fpsot.org/model/data-types> .
dat:Instant a rdfs:Datatype ;
	owl:equivalentClass _:c14n136 .
dat:Uuid a rdfs:Datatype ;
	owl:equivalentClass _:c14n0 .
dat:end a owl:DatatypeProperty ;
	rdfs:label "end" ;
	skos:inScheme <https://fpsot.org/model/data-types> .
dat:start a owl:DatatypeProperty ;
	rdfs:label "start" ;
	skos:inScheme <https://fpsot.org/model/data-types> .
<https://fpsot.org/model/party.owl.ttl> dcterms:license "Community-Spec-1.0" ;
	dcterms:title "FPSOT Party model" ;
	pav:version "0.1.0" ;
	a owl:Ontology ;
	rdfs:label "party" ;
	skos:definition "LinkML model of the Party subject area of the FPSOT data models specification: parties, persons, organizations, party roles, party relationships, contact mechanisms, identifications and classifications. It follows the party patterns of the universal data models, as Apache OFBiz implements them, adapted to the FPSOT naming, data types, vocabularies and internationalization specifications. Each element cites its requirement IDs. The model says nothing about storage (DMO-003)." .
party:ContactMechanism a owl:Class ;
	rdfs:label "ContactMechanism" ;
	rdfs:subClassOf party:Entity , _:c14n104 , _:c14n167 , _:c14n214 , _:c14n56 ;
	skos:definition "A way to reach a party: a postal address, a telephone number, a telephone short code or an email address. Apache OFBiz calls it ContactMech. DMO-045." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:ContactMechanismType a owl:Class ;
	rdfs:label "ContactMechanismType" ;
	owl:unionOf _:c14n5 ;
	skos:definition "The four kinds of contact mechanism of this version. Each meaning is a concept of the planned FPSOT scheme https://fpsot.org/vocabularies/contact-mechanism-types, which will be published under the FPSOT vocabularies specification; its URIs are reserved under VOC-002 to VOC-004. DMO-030, DMO-045." ;
	skos:inScheme <https://fpsot.org/model/party> ;
	linkml:permissible_values contactMechanismTypes:email-address , contactMechanismTypes:postal-address , contactMechanismTypes:telephone-number , contactMechanismTypes:telephone-short-code .
party:CountryCode a rdfs:Datatype ;
	owl:equivalentClass _:c14n123 .
party:EmailAddress a owl:Class ;
	rdfs:label "EmailAddress" ;
	rdfs:subClassOf party:ContactMechanism , _:c14n164 , _:c14n173 , _:c14n226 , _:c14n3 , _:c14n71 , _:c14n92 ;
	skos:definition "An email address. DMO-034." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:EmailAddressMechanismType a owl:Class ;
	rdfs:label "EmailAddressMechanismType" ;
	skos:definition "The contact mechanism type of an email address. DMO-045." ;
	skos:inScheme <https://fpsot.org/model/party> ;
	linkml:permissible_values contactMechanismTypes:email-address .
party:EmailAddressValue a rdfs:Datatype ;
	owl:equivalentClass _:c14n19 .
party:Entity a owl:Class ;
	rdfs:label "Entity" ;
	rdfs:subClassOf _:c14n100 , _:c14n102 , _:c14n202 , _:c14n207 , _:c14n246 , _:c14n4 , _:c14n53 , _:c14n55 , _:c14n61 , _:c14n7 , _:c14n79 , _:c14n82 , _:c14n83 ;
	skos:definition "Fields that every entity of the model has: an identifier, audit instants and the extensions object. An entity is a class whose records exist on their own and that other data can refer to. A value class, such as PersonName or DateInterval, exists only inlined in an entity, so it has no identifier and no audit instants. Departs from Apache OFBiz (DMO-006): each entity has its own UUID key, never a key of several fields. DMO-021, DMO-022, DMO-050, DMO-053." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:Extensions a owl:Class ;
	rdfs:label "Extensions" ;
	skos:definition "The extensions object. Each member is named after the ISO 3166-1 or ISO 3166-2 code of one jurisdiction, in lowerCamelCase, such as ca or caQc. A jurisdiction with no such code nests its member in the member of the nearest coded jurisdiction, such as caQc.montreal. Its value is an object that the profile of that jurisdiction defines. The core model accepts any member, so that a system can keep extensions it does not know. The generated SHACL shape of this class is left open after generation, as model/test-model.sh records. DMO-053, DMO-056." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:LanguageTag a rdfs:Datatype ;
	owl:equivalentClass _:c14n74 .
party:NameText a rdfs:Datatype ;
	owl:equivalentClass _:c14n129 .
party:Organization a owl:Class ;
	rdfs:label "Organization" ;
	rdfs:subClassOf party:Party , _:c14n101 , _:c14n111 , _:c14n119 , _:c14n140 , _:c14n94 ;
	skos:definition "A group of people with a shared purpose, such as a business, a public body or an association. Apache OFBiz calls it PartyGroup. DMO-042." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:OrganizationName a owl:Class ;
	rdfs:label "OrganizationName" ;
	rdfs:subClassOf _:c14n107 , _:c14n114 , _:c14n144 , _:c14n16 , _:c14n181 , _:c14n193 , _:c14n218 , _:c14n243 , _:c14n33 , _:c14n38 , _:c14n72 , _:c14n88 ;
	skos:definition "One name of an organization, as registered or used. A value class inlined in its organization, so it has no identifier and no audit instants. DMO-021, DMO-035, DMO-042." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:OrganizationPartyType a owl:Class ;
	rdfs:label "OrganizationPartyType" ;
	skos:definition "The party type of an organization. DMO-040." ;
	skos:inScheme <https://fpsot.org/model/party> ;
	linkml:permissible_values partyTypes:organization .
party:Party a owl:Class ;
	rdfs:label "Party" ;
	rdfs:subClassOf party:Entity , _:c14n13 , _:c14n212 , _:c14n80 , _:c14n91 ;
	skos:definition "A person or an organization. Each party is exactly one of the two. DMO-040." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:PartyClassification a owl:Class ;
	rdfs:label "PartyClassification" ;
	rdfs:subClassOf party:Entity , _:c14n10 , _:c14n106 , _:c14n117 , _:c14n126 , _:c14n148 , _:c14n219 , _:c14n220 , _:c14n230 , _:c14n28 , _:c14n57 , _:c14n58 , _:c14n69 ;
	skos:definition "Places a party in a category of a controlled vocabulary, such as an industry. Departs from Apache OFBiz (DMO-006): OFBiz links a party to a PartyClassificationGroup record. This model holds the URI of a concept scheme and a code, so that categories come from published vocabularies (DMO-030). DMO-047." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:PartyContactMechanism a owl:Class ;
	rdfs:label "PartyContactMechanism" ;
	rdfs:subClassOf party:Entity , _:c14n118 , _:c14n138 , _:c14n153 , _:c14n183 , _:c14n192 , _:c14n205 , _:c14n35 , _:c14n40 , _:c14n41 , _:c14n76 , _:c14n8 ;
	skos:definition "Links a party to a contact mechanism, for some purposes and a period. DMO-045." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:PartyContainer a owl:Class ;
	rdfs:label "PartyContainer" ;
	rdfs:subClassOf _:c14n110 , _:c14n116 , _:c14n132 , _:c14n139 , _:c14n143 , _:c14n150 , _:c14n176 , _:c14n184 , _:c14n188 , _:c14n203 , _:c14n208 , _:c14n240 , _:c14n249 , _:c14n37 , _:c14n42 , _:c14n44 , _:c14n45 , _:c14n46 , _:c14n54 , _:c14n68 , _:c14n86 , _:c14n89 ;
	skos:definition "A container that carries records of the Party subject area in one document, one list per class, such as for a bulk exchange or a test. It is not an entity: it has no identifier and no audit instants. It is the root class of the generated JSON Schema. DMO-014." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:PartyIdentification a owl:Class ;
	rdfs:label "PartyIdentification" ;
	rdfs:subClassOf party:Entity , _:c14n162 , _:c14n171 , _:c14n231 , _:c14n237 , _:c14n242 , _:c14n248 , _:c14n25 , _:c14n251 , _:c14n47 , _:c14n52 , _:c14n60 , _:c14n65 , _:c14n84 , _:c14n98 , _:c14n99 ;
	skos:definition "An identifier that a body issued for a party, such as a business number. Departs from Apache OFBiz (DMO-006): OFBiz keys PartyIdentification by the party and the identification type, with no period and no issuer, so a party holds one identifier per type. This model gives each identification its own id, a period and an optional issuer, because an identifier can expire or be replaced while the party stays the same. DMO-046." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:PartyRelationship a owl:Class ;
	rdfs:label "PartyRelationship" ;
	rdfs:subClassOf party:Entity , _:c14n12 , _:c14n120 , _:c14n135 , _:c14n14 , _:c14n145 , _:c14n149 , _:c14n157 , _:c14n168 , _:c14n179 , _:c14n18 , _:c14n180 , _:c14n186 , _:c14n224 , _:c14n227 , _:c14n32 , _:c14n39 , _:c14n81 , _:c14n96 ;
	skos:definition "A relationship between two parties, each in a role, such as an employee and an employer. DMO-044." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:PartyRole a owl:Class ;
	rdfs:label "PartyRole" ;
	rdfs:subClassOf party:Entity , _:c14n105 , _:c14n113 , _:c14n158 , _:c14n159 , _:c14n172 , _:c14n221 , _:c14n223 , _:c14n78 , _:c14n97 ;
	skos:definition "A role that a party plays, such as applicant, employer or supplier. Departs from Apache OFBiz (DMO-006): the role has a period, and the role is a code instead of a RoleType record. DMO-043." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:PartyType a owl:Class ;
	rdfs:label "PartyType" ;
	owl:unionOf _:c14n95 ;
	skos:definition "The two kinds of party. The model defines them, so they change only with a major version. Each meaning is a concept of the planned FPSOT scheme https://fpsot.org/vocabularies/party-types, which will be published under the FPSOT vocabularies specification; its URIs are reserved under VOC-002 to VOC-004. DMO-030, DMO-040." ;
	skos:inScheme <https://fpsot.org/model/party> ;
	linkml:permissible_values partyTypes:organization , partyTypes:person .
party:Person a owl:Class ;
	rdfs:label "Person" ;
	rdfs:subClassOf party:Party , _:c14n103 , _:c14n130 , _:c14n137 , _:c14n160 , _:c14n21 , _:c14n211 , _:c14n43 , _:c14n77 ;
	skos:definition "A human being. DMO-041." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:PersonName a owl:Class ;
	rdfs:label "PersonName" ;
	rdfs:subClassOf _:c14n115 , _:c14n121 , _:c14n128 , _:c14n152 , _:c14n156 , _:c14n161 , _:c14n177 , _:c14n178 , _:c14n182 , _:c14n204 , _:c14n217 , _:c14n232 , _:c14n238 , _:c14n239 , _:c14n51 , _:c14n63 , _:c14n66 , _:c14n67 ;
	skos:definition "One name of a person, a value class inlined in its person, so it has no identifier and no audit instants. Only the full name is required. Departs from Apache OFBiz (DMO-006): OFBiz keeps one set of name parts on Person, such as firstName and lastName, and a PartyNameHistory keyed by the date of change. This model keeps several names, each with a type and a period, and requires only the full name, because many names have no first and last parts (LOC-050). DMO-021, DMO-032." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:PersonPartyType a owl:Class ;
	rdfs:label "PersonPartyType" ;
	skos:definition "The party type of a person. DMO-040." ;
	skos:inScheme <https://fpsot.org/model/party> ;
	linkml:permissible_values partyTypes:person .
party:PostalAddress a owl:Class ;
	rdfs:label "PostalAddress" ;
	rdfs:subClassOf party:ContactMechanism , _:c14n124 , _:c14n125 , _:c14n131 , _:c14n141 , _:c14n151 , _:c14n163 , _:c14n169 , _:c14n170 , _:c14n185 , _:c14n190 , _:c14n191 , _:c14n196 , _:c14n2 , _:c14n20 , _:c14n200 , _:c14n210 , _:c14n216 , _:c14n233 , _:c14n241 , _:c14n26 , _:c14n29 , _:c14n36 , _:c14n48 , _:c14n49 , _:c14n59 , _:c14n6 , _:c14n75 , _:c14n87 , _:c14n9 ;
	skos:definition "A postal address in separate fields, kept as written. Only the country is required. Departs from Apache OFBiz (DMO-006): OFBiz holds address1 and address2, a numeric houseNumber, recipient names, and references to Geo records for the city, the region and the country. This model keeps each part as written, with the region and the country as codes in the form of their issuer, and holds no recipient name, because each country orders and writes its addresses in its own way (LOC-053, DAT-066). DMO-033, LOC-055." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:PostalAddressMechanismType a owl:Class ;
	rdfs:label "PostalAddressMechanismType" ;
	skos:definition "The contact mechanism type of a postal address. DMO-045." ;
	skos:inScheme <https://fpsot.org/model/party> ;
	linkml:permissible_values contactMechanismTypes:postal-address .
party:TelephoneNumber a owl:Class ;
	rdfs:label "TelephoneNumber" ;
	rdfs:subClassOf party:ContactMechanism , _:c14n1 , _:c14n194 , _:c14n195 , _:c14n209 , _:c14n215 , _:c14n229 , _:c14n50 , _:c14n73 , _:c14n90 ;
	skos:definition "A telephone number in the international form. Departs from Apache OFBiz (DMO-006): OFBiz TelecomNumber splits the country code, the area code and the number, and keeps the extension on PartyContactMech. This model keeps one E.164 string, because not every numbering plan has area codes, and keeps the extension with the number. DMO-034." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:TelephoneNumberMechanismType a owl:Class ;
	rdfs:label "TelephoneNumberMechanismType" ;
	skos:definition "The contact mechanism type of a telephone number. DMO-045." ;
	skos:inScheme <https://fpsot.org/model/party> ;
	linkml:permissible_values contactMechanismTypes:telephone-number .
party:TelephoneNumberValue a rdfs:Datatype ;
	owl:equivalentClass _:c14n187 .
party:TelephoneShortCode a owl:Class ;
	rdfs:label "TelephoneShortCode" ;
	rdfs:subClassOf party:ContactMechanism , _:c14n133 , _:c14n154 , _:c14n166 , _:c14n201 , _:c14n23 , _:c14n236 , _:c14n247 , _:c14n70 , _:c14n93 ;
	skos:definition "A short code that people dial within one country, such as 211 or 311. It has no E.164 form, so it is a separate kind of contact mechanism. DMO-034." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:TelephoneShortCodeMechanismType a owl:Class ;
	rdfs:label "TelephoneShortCodeMechanismType" ;
	skos:definition "The contact mechanism type of a telephone short code. DMO-045." ;
	skos:inScheme <https://fpsot.org/model/party> ;
	linkml:permissible_values contactMechanismTypes:telephone-short-code .
party:address a owl:DatatypeProperty ;
	rdfs:label "address" ;
	skos:definition "The address, kept as the person wrote it." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:addressLines a owl:DatatypeProperty ;
	rdfs:label "addressLines" ;
	skos:definition "Other lines of the address, in order, for countries whose parts do not fit the other fields." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:birthDate a owl:DatatypeProperty ;
	rdfs:label "birthDate" ;
	skos:definition "The date of birth, when a process needs it. DMO-041." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:civicNumber a owl:DatatypeProperty ;
	rdfs:label "civicNumber" ;
	skos:definition "The civic number, with its suffix, such as 1200 or 12A." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:code a owl:DatatypeProperty .
party:conceptScheme a owl:DatatypeProperty ;
	rdfs:label "conceptScheme" ;
	skos:definition "The URI of the concept scheme. DMO-047." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:contactMechanismId a owl:ObjectProperty ;
	rdfs:label "contactMechanismId" ;
	rdfs:range party:ContactMechanism ;
	skos:definition "The contact mechanism that the link ties to the party. DMO-045." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:contactMechanismType a owl:ObjectProperty ;
	rdfs:label "contactMechanismType" ;
	skos:definition "The kind of contact mechanism: a code of the ContactMechanismType enumeration, which each subclass fixes to one value. DMO-045." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:country a owl:DatatypeProperty .
party:createdAt a owl:DatatypeProperty ;
	rdfs:label "createdAt" ;
	skos:definition "When the system of record first stored the entity. Optional in the core model, so that a record sent in to be created can omit it. Required in every record that a system of record emits. DMO-050." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:emailAddresses a owl:ObjectProperty ;
	rdfs:label "emailAddresses" ;
	skos:definition "Email addresses. DMO-034, DMO-045." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:extensionNumber a owl:DatatypeProperty ;
	rdfs:label "extensionNumber" ;
	skos:definition "The internal extension, digits only." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:extensions a owl:ObjectProperty ;
	rdfs:label "extensions" ;
	skos:definition "Fields that one jurisdiction adds, keyed by jurisdiction code. DMO-053 to DMO-056." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:familyName a owl:DatatypeProperty ;
	rdfs:label "familyName" ;
	skos:definition "The family name, only when a process needs the parts." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:fullName a owl:DatatypeProperty ;
	rdfs:label "fullName" ;
	skos:definition "The whole name, as the person writes it." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:givenNames a owl:DatatypeProperty ;
	rdfs:label "givenNames" ;
	skos:definition "The given names, only when a process needs the parts." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:id a owl:DatatypeProperty ;
	rdfs:label "id" ;
	skos:definition "The identifier of the entity. New ones should be version 7 UUIDs (DAT-063), and must be version 4 when DAT-064 applies. DMO-021." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:identificationScheme a owl:DatatypeProperty ;
	rdfs:label "identificationScheme" ;
	skos:definition "The identification scheme, from a scheme of identification schemes that the deployment names. DMO-031, DMO-046." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:issuerId a owl:ObjectProperty ;
	rdfs:label "issuerId" ;
	skos:definition "The organization that issued the identifier, when the model holds it." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:language a owl:DatatypeProperty ;
	rdfs:label "language" ;
	rdfs:range party:LanguageTag ;
	skos:definition "The language in which the text is written, when known. LOC-055." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:locality a owl:DatatypeProperty ;
	rdfs:label "locality" ;
	skos:definition "The municipality or locality, never translated." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:name a owl:DatatypeProperty ;
	rdfs:label "name" ;
	skos:definition "The name as the organization writes it, never translated by the system." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:nameType a owl:DatatypeProperty ;
	rdfs:label "nameType" ;
	rdfs:range dat:CodeValue ;
	skos:definition "The kind of name, such as legal or preferred, from a scheme that the deployment names. DMO-030, DMO-031." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:names a owl:ObjectProperty .
party:number a owl:DatatypeProperty ;
	rdfs:label "number" ;
	skos:definition "The number in E.164 form. The leading plus sign is the notation of ITU-T E.123." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:organizations a owl:ObjectProperty ;
	rdfs:label "organizations" ;
	skos:definition "Organizations. DMO-042." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:partyClassifications a owl:ObjectProperty ;
	rdfs:label "partyClassifications" ;
	skos:definition "Party classifications. DMO-047." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:partyContactMechanisms a owl:ObjectProperty ;
	rdfs:label "partyContactMechanisms" ;
	skos:definition "Links between parties and contact mechanisms. DMO-045." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:partyId a owl:ObjectProperty ;
	rdfs:label "partyId" ;
	rdfs:range party:Party ;
	skos:definition "The party that the entity is about. NAM-040." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:partyIdentifications a owl:ObjectProperty ;
	rdfs:label "partyIdentifications" ;
	skos:definition "Party identifications. DMO-046." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:partyRelationships a owl:ObjectProperty ;
	rdfs:label "partyRelationships" ;
	skos:definition "Party relationships. DMO-044." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:partyRoles a owl:ObjectProperty ;
	rdfs:label "partyRoles" ;
	skos:definition "Party roles. DMO-043." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:partyType a owl:ObjectProperty ;
	rdfs:label "partyType" ;
	skos:definition "Whether the party is a person or an organization: a code of the PartyType enumeration, which each subclass fixes to one value. DMO-040." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:persons a owl:ObjectProperty ;
	rdfs:label "persons" ;
	skos:definition "Persons. DMO-041." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:postalAddresses a owl:ObjectProperty ;
	rdfs:label "postalAddresses" ;
	skos:definition "Postal addresses. DMO-033, DMO-045." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:postalCode a owl:DatatypeProperty ;
	rdfs:label "postalCode" ;
	skos:definition "The postal code in the form of its issuer, such as H2X 1Y4. Some countries have none." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:purposes a owl:DatatypeProperty ;
	rdfs:label "purposes" ;
	skos:definition "What the party uses the mechanism for, such as billing or mailing, from a scheme that the deployment names. Departs from Apache OFBiz (DMO-006): OFBiz keeps each purpose in its own PartyContactMechPurpose record, with its own period. Here every purpose shares the period of the link, and a purpose with another period needs another link, so that one record holds one period. DMO-030, DMO-031." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:region a owl:DatatypeProperty ;
	rdfs:label "region" ;
	skos:definition "The province, state or other region, in the form of its issuer, such as QC." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:relatedPartyId a owl:ObjectProperty ;
	rdfs:label "relatedPartyId" ;
	skos:definition "The second party of the relationship." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:relatedRole a owl:DatatypeProperty ;
	rdfs:label "relatedRole" ;
	skos:definition "The role of the second party in the relationship. DMO-030." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:relationshipType a owl:DatatypeProperty ;
	rdfs:label "relationshipType" ;
	skos:definition "The kind of relationship, from a scheme that the deployment names. DMO-030, DMO-031." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:role a owl:DatatypeProperty .
party:street a owl:DatatypeProperty ;
	rdfs:label "street" ;
	skos:definition "The street name with its type and direction, as written, such as rue Principale Ouest." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:telephoneNumbers a owl:ObjectProperty ;
	rdfs:label "telephoneNumbers" ;
	skos:definition "Telephone numbers. DMO-034, DMO-045." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:telephoneShortCodes a owl:ObjectProperty ;
	rdfs:label "telephoneShortCodes" ;
	skos:definition "Telephone short codes. DMO-034, DMO-045." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:unit a owl:DatatypeProperty ;
	rdfs:label "unit" ;
	skos:definition "The apartment, suite or unit, as written." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:updatedAt a owl:DatatypeProperty ;
	rdfs:label "updatedAt" ;
	skos:definition "When the system of record last changed the entity. Optional in the core model, so that a record sent in to be created can omit it. Required in every record that a system of record emits. DMO-050." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:validity a owl:ObjectProperty ;
	rdfs:label "validity" ;
	rdfs:range dat:DateInterval ;
	skos:definition "When the fact holds: the start is included and the end is not. Replaces the fromDate and thruDate pair of Apache OFBiz (DMO-006). DMO-023, DAT-023." ;
	skos:inScheme <https://fpsot.org/model/party> .
party:value a owl:DatatypeProperty ;
	rdfs:label "value" ;
	skos:definition "The identifier, in the exact form of its issuer. DAT-066." ;
	skos:inScheme <https://fpsot.org/model/party> .
contactMechanismTypes:email-address a owl:Class ;
	rdfs:label "email-address" ;
	rdfs:subClassOf party:ContactMechanismType , party:EmailAddressMechanismType ;
	skos:definition "An email address." .
contactMechanismTypes:postal-address a owl:Class ;
	rdfs:label "postal-address" ;
	rdfs:subClassOf party:ContactMechanismType , party:PostalAddressMechanismType ;
	skos:definition "A postal address." .
contactMechanismTypes:telephone-number a owl:Class ;
	rdfs:label "telephone-number" ;
	rdfs:subClassOf party:ContactMechanismType , party:TelephoneNumberMechanismType ;
	skos:definition "A telephone number in E.164 form." .
contactMechanismTypes:telephone-short-code a owl:Class ;
	rdfs:label "telephone-short-code" ;
	rdfs:subClassOf party:ContactMechanismType , party:TelephoneShortCodeMechanismType ;
	skos:definition "A short code dialed within one country." .
partyTypes:organization a owl:Class ;
	rdfs:label "organization" ;
	rdfs:subClassOf party:OrganizationPartyType , party:PartyType ;
	skos:definition "A group of people with a shared purpose." .
partyTypes:person a owl:Class ;
	rdfs:label "person" ;
	rdfs:subClassOf party:PartyType , party:PersonPartyType ;
	skos:definition "A human being." .
