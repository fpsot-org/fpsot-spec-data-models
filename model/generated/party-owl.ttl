	skos:definition "Container used only to test the examples of this schema." ;
	skos:inScheme <https://fpsot.org/model/data-types> .
dat:Instant a rdfs:Datatype ;
	owl:equivalentClass _:c14n156 .
dat:InstantInterval a owl:Class ;
	rdfs:label "InstantInterval" ;
	rdfs:subClassOf _:c14n105 , _:c14n117 , _:c14n149 , _:c14n240 , _:c14n60 , _:c14n63 ;
	skos:definition "A span between two instants. The end is excluded and may be absent. DAT-023." ;
	skos:inScheme <https://fpsot.org/model/data-types> .
dat:LocalDateTime a rdfs:Datatype ;
	owl:equivalentClass _:c14n70 .
dat:Money a owl:Class ;
	rdfs:label "Money" ;
	rdfs:subClassOf _:c14n133 , _:c14n17 , _:c14n185 , _:c14n187 , _:c14n195 , _:c14n42 ;
