	sh:targetClass party:PartyClassification .
party:PartyContactMechanism a sh:NodeShape ;
	rdfs:comment "Links a party to a contact mechanism, for some purposes and a period. DMO-045." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n27 ;
