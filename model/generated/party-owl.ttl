	skos:inScheme <https://fpsot.org/model/data-types> .
dat:MultilingualText a owl:Class ;
	rdfs:label "MultilingualText" ;
	rdfs:subClassOf _:c14n112 , _:c14n128 , _:c14n211 , _:c14n225 , _:c14n228 , _:c14n6 ;
	skos:definition "Text in English and French, keyed by language tag. Other language tags are allowed as extra members. DAT-004 to DAT-006." ;
	skos:inScheme <https://fpsot.org/model/data-types> .
