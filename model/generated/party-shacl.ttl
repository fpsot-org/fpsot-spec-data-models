dat:DateInterval a sh:NodeShape ;
	rdfs:comment "A span between two dates. The end is excluded and may be absent. DAT-023." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n6 ;
	sh:property _:c14n110 , _:c14n67 ;
	sh:targetClass dat:DateInterval .
dat:Examples a sh:NodeShape ;
	rdfs:comment "Container used only to test the examples of this schema." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n168 ;
	sh:property _:c14n0 , _:c14n100 , _:c14n105 , _:c14n139 , _:c14n14 , _:c14n160 , _:c14n4 , _:c14n53 , _:c14n63 , _:c14n64 , _:c14n75 , _:c14n88 ;
